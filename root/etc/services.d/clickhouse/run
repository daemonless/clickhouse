#!/bin/sh
# ClickHouse s6 service

export HOME=/var/db/clickhouse
# One process, not watchdog + worker: on FreeBSD the worker hangs after
# "Waiting for background threads" on SIGTERM (ENOTCONN closing listeners),
# and a killed watchdog would leave it alive holding the log pipe.
export CLICKHOUSE_WATCHDOG_ENABLE=0

# Signal readiness once the healthcheck passes (FD 3, see notification-fd)
s6-ready-when /healthz

echo "[INFO] Starting ClickHouse server..."

exec /usr/local/bin/s6-setuidgid bsd \
    /usr/local/bin/clickhouse-server \
    --config-file=/usr/local/etc/clickhouse-server/config.xml
